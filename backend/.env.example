# Server Configuration
NODE_ENV=development
PORT=4000
CLIENT_ORIGIN=http://localhost:5173

# Neon PostgreSQL Database Connections
# Runtime pooled connection (port 6543 / pooler)
DATABASE_URL=postgresql://user:password@ep-sample-pooler.us-east-2.aws.neon.tech/civicpulse?sslmode=require
# Direct connection for migrations & extensions (port 5432)
DATABASE_URL_UNPOOLED=postgresql://user:password@ep-sample.us-east-2.aws.neon.tech/civicpulse?sslmode=require

# Authentication & JWT
JWT_ACCESS_SECRET=your_super_secret_access_key_min_32_chars_long
JWT_REFRESH_SECRET=your_super_secret_refresh_key_min_32_chars_long
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d

# Cloudinary (Media Storage)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Cloudflare R2 / S3 Storage (GPS & Audit Archives)
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=civicpulse-archives
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# External Services
WEATHER_API_BASE_URL=https://api.open-meteo.com/v1
ALERT_CACHE_TTL_SECONDS=600

# Operational Throttling
LOCATION_CLIENT_INTERVAL_MS=5000
LOCATION_PERSIST_INTERVAL_MS=60000
LOCATION_PERSIST_DISTANCE_METERS=25
LOCATION_RETENTION_DAYS=30
